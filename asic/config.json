{
  "DESIGN_NAME": "top_level",
  "VERILOG_FILES": "dir::src/*.v",
  "VERILOG_INCLUDE_DIRS": ["dir::src"],

  "PDK": "sky130A",
  "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
  "CLOCK_PORT": "clk",
  "CLOCK_PERIOD": 13.0,
  "RUN_CTS": true,
  "CTS_SINK_CLUSTERING_SIZE": 10,

  "SYNTH_STRATEGY": "DELAY 0",
  "SYNTH_ABC_BUFFERING": true,
  "SYNTH_SIZING": true,
  "MAX_TRANSITION_CONSTRAINT": 0.6,

  "FP_CORE_UTIL": 30,
  "PL_TARGET_DENSITY_PCT": 35,
  "RUN_POST_GPL_DESIGN_REPAIR": true,
  "RUN_POST_CTS_RESIZER_TIMING": true,
  "DESIGN_REPAIR_BUFFER_INPUT_PORTS": true,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": true,
  "DESIGN_REPAIR_TIE_FANOUT": true,

  "RUN_POST_GRT_RESIZER_TIMING": true,
  "GLB_RESIZER_DESIGN_OPTIMIZATIONS": true,
  "GRT_RESIZER_TIMING_OPTIMIZATIONS": true,

  "GRT_ADJUSTMENT": 0.15,

  "RUN_ANTENNA_REPAIR": true,
  "RUN_HEURISTIC_DIODE_INSERTION": true,
  "GRT_ANTENNA_ITERS": 7,
  "GRT_ANTENNA_MARGIN": 15,
  

  "FP_PDN_VPITCH": 40,
  "FP_PDN_HPITCH": 40,
  "FP_PDN_VOFFSET": 15,
  "FP_PDN_HOFFSET": 15,
  "FP_PDN_SKIPTRIM": true,

  "RUN_KLAYOUT_DRC": true,
  
  "MAX_FANOUT_CONSTRAINT": 10
}
